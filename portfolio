      margin-bottom: 0.8rem;
    }

    .cta p {
      color: var(--text-muted);
      margin-bottom: 1.5rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-email {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--accent);
      color: #042f2e;
      font-weight: 700;
      padding: 0.8rem 1.6rem;
      border-radius: 10px;
      font-size: 1rem;
      transition: all 0.2s;
    }

    .cta-email:hover {
      background: #34d399;
      box-shadow: 0 0 20px var(--accent-glow);
    }

    footer {
      border-top: 1px solid var(--card-border);
      padding: 2rem 0;
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-sub);
    }

    @media (max-width: 768px) {
      .navbar {
        flex-direction: column;
        height: auto;
        padding: 1rem 0;
        gap: 0.8rem;
      }
      .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
      }
    }
  </style>
</head>
