  <style>
    :root {
      --bg: #090d16;
      --card-bg: #111827;
      --card-border: #1f2937;
      --card-hover: #1e293b;
      --accent: #10b981;
      --accent-glow: rgba(16, 185, 129, 0.2);
      --accent-blue: #38bdf8;
      --text: #f3f4f6;
      --text-muted: #9ca3af;
      --text-sub: #6b7280;
      --badge-bg: rgba(16, 185, 129, 0.1);
      --badge-border: rgba(16, 185, 129, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .stat-value {
      font-family: 'Space Grotesk', sans-serif;
      letter-spacing: -0.02em;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Header & Nav */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(9, 13, 22, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--card-border);
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 70px;
    }

    .brand {
      font-weight: 700;
      font-size: 1.25rem;
      background: linear-gradient(135deg, #fff, var(--text-muted));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand span {
      color: var(--accent);
      -webkit-text-fill-color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.9rem;
      color: var(--text-muted);
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .btn-contact {
      background: var(--accent);
      color: #042f2e;
      padding: 0.5rem 1.1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .btn-contact:hover {
      background: #34d399;
      box-shadow: 0 0 15px var(--accent-glow);
    }

    /* Hero */
    .hero {
      padding: 5rem 0 3rem;
      position: relative;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      background: var(--badge-bg);
      border: 1px solid var(--badge-border);
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 1.2rem;
    }

    .hero h1 {
      font-size: clamp(2.2rem, 5vw, 3.8rem);
      line-height: 1.1;
      font-weight: 800;
      max-width: 900px;
      margin-bottom: 1.2rem;
    }

    .hero p {
      font-size: 1.1rem;
      color: var(--text-muted);
      max-width: 750px;
      margin-bottom: 2rem;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.2rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 3rem;
    }

    .hero-meta span {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 4rem;
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.4rem;
      text-align: center;
    }

    .stat-card .stat-value {
      font-size: 2.2rem;
      font-weight: 700;
      color: var(--accent);
      line-height: 1;
      margin-bottom: 0.4rem;
    }

    .stat-card .stat-label {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Toolkit */
    .section-title {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .section-desc {
      color: var(--text-muted);
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }

    .toolkit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.2rem;
      margin-bottom: 4.5rem;
    }

    .tool-group {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.4rem;
    }

    .tool-group h3 {
      font-size: 0.9rem;
      color: var(--accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 1rem;
    }

    .tool-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      font-size: 0.8rem;
    }

    /* Case Studies */
    .case-studies {
      margin-bottom: 5rem;
    }

    .case-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .case-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 1.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s, border-color 0.2s;
    }

    .case-card:hover {
      transform: translateY(-3px);
      border-color: rgba(16, 185, 129, 0.4);
    }

    .case-header {
      margin-bottom: 1rem;
    }

    .case-num {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.3rem;
    }

    .case-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.3rem;
    }

    .case-subtitle {
      font-size: 0.85rem;
      color: var(--accent-blue);
      margin-bottom: 1rem;
    }

    /* Metrics Table inside card */
    .metrics-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
      font-size: 0.8rem;
    }

    .metrics-table th, .metrics-table td {
      padding: 0.45rem 0.5rem;
      text-align: left;
      border-bottom: 1px solid var(--card-border);
    }

    .metrics-table th {
      color: var(--text-sub);
      font-weight: 600;
      text-transform: uppercase;
    }

    .metrics-table .lift {
      color: var(--accent);
      font-weight: 700;
      text-align: right;
    }

    .highlight-pill {
      display: inline-block;
      padding: 0.25rem 0.6rem;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid var(--accent);
      color: var(--accent);
      font-size: 0.8rem;
      font-weight: 700;
      border-radius: 6px;
      margin-bottom: 1rem;
    }

    .case-body ul {
      list-style: none;
      padding: 0;
      margin-top: 0.5rem;
    }

    .case-body li {
      position: relative;
      padding-left: 1.2rem;
      margin-bottom: 0.6rem;
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .case-body li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--accent);
      font-weight: bold;
    }

    .case-body li strong {
      color: var(--text);
    }

    /* Compact Case List */
    .compact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.2rem;
      margin-top: 2rem;
    }

    .compact-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.3rem;
    }

    .compact-card h4 {
      font-size: 1.05rem;
      margin-bottom: 0.4rem;
    }

    .compact-card .badge {
      display: inline-block;
      font-size: 0.7rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--accent-blue);
      margin-bottom: 0.4rem;
    }

    .compact-card p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.6rem;
    }

    /* CTA Section */
    .cta {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(56, 189, 248, 0.05) 100%);
      border: 1px solid var(--badge-border);
      border-radius: 16px;
      padding: 3rem 2rem;
      text-align: center;
      margin-bottom: 5rem;
    }

    .cta h2 {
